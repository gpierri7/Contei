{
  "expo": {
    "name": "Contei",
    "slug": "contei",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "contei",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0D1A",
    "androidStatusBar": {
      "backgroundColor": "#0F0D1A",
      "barStyle": "light-content",
      "translucent": false
    },
    "android": {
      "package": "com.pierri.contei",
      "userInterfaceStyle": "dark",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0F0D1A",
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0D1A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6C3FD1",
          "defaultChannel": "limite",
          "sounds": []
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Contei usa a biometria para desbloquear seu app."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-system-ui",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Contei usa o microfone para você registrar gastos falando.",
          "speechRecognitionPermission": "O Contei usa o reconhecimento de fala para entender o que você diz ao registrar um gasto.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.samsung.android.bixbyagent"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2287db89-b050-4f4e-95be-7fae8ed8c608"
      }
    }
  }
}
